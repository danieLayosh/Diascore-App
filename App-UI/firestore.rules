rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /Users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /Users/{userId}/Diagnoses/{diagnosisId} {
      // Allow reading if authenticated or using a valid link
      allow read: if request.auth != null && request.auth.uid == userId
        || (exists(/databases/$(database)/documents/Links/$(request.query.linkId))
            && get(/databases/$(database)/documents/Links/$(request.query.linkId)).data.secretToken == request.query.secretToken
            && get(/databases/$(database)/documents/Links/$(request.query.linkId)).data.diagnosisId == diagnosisId
            && get(/databases/$(database)/documents/Links/$(request.query.linkId)).data.userId == userId);
      
      // Allow writing if authenticated or using a valid link
      allow write: if request.auth != null && request.auth.uid == userId
        || (request.resource.data.linkId is string
            && request.resource.data.secretToken is string
            && exists(/databases/$(database)/documents/Links/$(request.resource.data.linkId))
            && get(/databases/$(database)/documents/Links/$(request.resource.data.linkId)).data.secretToken == request.resource.data.secretToken
            && get(/databases/$(database)/documents/Links/$(request.resource.data.linkId)).data.diagnosisId == diagnosisId
            && get(/databases/$(database)/documents/Links/$(request.resource.data.linkId)).data.userId == userId);
    }
    
    match /Links/{linkId} {
      // Allow reading the link if it exists and has the correct secret token
      allow read: if resource != null 
        && !resource.data.submitted
        && resource.data.expirationDate > request.time;
      
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.secretToken is string
        && request.resource.data.secretToken.size() == 64;
        
      // Allow updating the link with answers
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['submitted', 'submittedAt', 'answers'])
            && resource.data.secretToken == request.resource.data.secretToken
            && !resource.data.submitted
            && resource.data.expirationDate > request.time);
            
      allow delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }
  }
}
